  "documents": [
    {
      "id": "doc_alpha_renewal",
      "corpus_id": "enterprise-thin-slice",
      "title": "Alpha Analytics Renewal Memo",
      "segments": [
        {
          "id": "alpha_renewal_s1",
          "document_id": "doc_alpha_renewal",
          "order": 1,
          "text": "On January 15, 2026, the sourcing council approved a two-year renewal with Alpha Analytics after service-level performance reached 99.94 percent.",
          "metadata": {
            "section": "approval"
          }
        },
        {
          "id": "alpha_renewal_s2",
          "document_id": "doc_alpha_renewal",
          "order": 2,
          "text": "The renewal caps annual support fees at $480,000 and includes a 6 percent service-credit penalty if uptime falls below 99.9 percent.",
          "metadata": {
            "section": "commercial_terms"
          }
        },
        {
          "id": "alpha_renewal_s3",
          "document_id": "doc_alpha_renewal",
          "order": 3,
          "text": "Legal required the contract owner, Priya Shah, to complete a data-processing addendum before production data can be shared with Alpha Analytics.",
          "metadata": {
            "section": "legal"
          }
        }
      ],
      "metadata": {
        "source_type": "vendor_memo",
        "business_area": "sourcing"
      }
    },
    {
      "id": "doc_beta_payments",
      "corpus_id": "enterprise-thin-slice",
      "title": "Beta Payment Incident Review",
      "segments": [
        {
          "id": "beta_payments_s1",
          "document_id": "doc_beta_payments",
          "order": 1,
          "text": "The Beta payment outage started at 14:20 UTC on February 9, 2026 when the settlement queue stopped acknowledging card batches.",
          "metadata": {
            "section": "timeline_start"
          }
        },
        {
          "id": "beta_payments_s2",
          "document_id": "doc_beta_payments",
          "order": 2,
          "text": "Service was fully restored at 16:05 UTC after the payments team replayed 18,420 queued transactions from the backup ledger.",
          "metadata": {
            "section": "timeline_recovery"
          }
        },
        {
          "id": "beta_payments_s3",
          "document_id": "doc_beta_payments",
          "order": 3,
          "text": "The postmortem assigned Samir Patel to add settlement queue lag alerts by March 1, 2026.",
          "metadata": {
            "section": "remediation"
          }
        }
      ],
      "metadata": {
        "source_type": "incident_review",
        "business_area": "payments"
      }
    },
    {
      "id": "doc_remote_access",
      "corpus_id": "enterprise-thin-slice",
      "title": "Remote Access Policy Update",
      "segments": [
        {
          "id": "remote_access_s1",
          "document_id": "doc_remote_access",
          "order": 1,
          "text": "The security office changed the remote access policy on March 12, 2026 to require phishing-resistant MFA for administrators.",
          "metadata": {
            "section": "administrator_access"
          }
        },
        {
          "id": "remote_access_s2",
          "document_id": "doc_remote_access",
          "order": 2,
          "text": "Temporary vendor access now expires after seven days unless the sponsoring director files a renewal ticket.",
          "metadata": {
            "section": "vendor_access"
          }
        },
        {
          "id": "remote_access_s3",
          "document_id": "doc_remote_access",
          "order": 3,
          "text": "The exception review board meets every Wednesday and must approve any remote access bypass longer than 24 hours.",
          "metadata": {
            "section": "exceptions"
          }
        }
      ],
      "metadata": {
        "source_type": "security_policy",
        "business_area": "security"
      }
    },
    {
      "id": "doc_orion_launch",
      "corpus_id": "enterprise-thin-slice",
      "title": "Project Orion Launch Brief",
      "segments": [
        {
          "id": "orion_launch_s1",
          "document_id": "doc_orion_launch",
          "order": 1,
          "text": "Project Orion will launch the customer analytics dashboard in the Nordic region on May 4, 2026.",
          "metadata": {
            "section": "launch_plan"
          }
        },
        {
          "id": "orion_launch_s2",
          "document_id": "doc_orion_launch",
          "order": 2,
          "text": "The launch depends on completion of localization testing, privacy review, and a go-live checklist owned by Mei Chen.",
          "metadata": {
            "section": "dependencies"
          }
        },
        {
          "id": "orion_launch_s3",
          "document_id": "doc_orion_launch",
          "order": 3,
          "text": "If privacy review slips past April 20, 2026, the fallback plan is to launch read-only reporting first.",
          "metadata": {
            "section": "fallback"
          }
        }
      ],
      "metadata": {
        "source_type": "launch_brief",
        "business_area": "product"
      }
    },
    {
      "id": "doc_q3_budget",
      "corpus_id": "enterprise-thin-slice",
      "title": "Q3 Infrastructure Budget",
      "segments": [
        {
          "id": "q3_budget_s1",
          "document_id": "doc_q3_budget",
          "order": 1,
          "text": "Finance approved a Q3 infrastructure budget of $1.8 million for capacity upgrades across compute, storage, and observability.",
          "metadata": {
            "section": "budget_total"
          }
        },
        {
          "id": "q3_budget_s2",
          "document_id": "doc_q3_budget",
          "order": 2,
          "text": "$650,000 is reserved for GPU inference capacity, $420,000 for database storage, and $180,000 for reliability drills.",
          "metadata": {
            "section": "allocations"
          }
        },
        {
          "id": "q3_budget_s3",
          "document_id": "doc_q3_budget",
          "order": 3,
          "text": "The budget review board asked infrastructure leaders to report forecast variance above 8 percent within five business days.",
          "metadata": {
            "section": "variance_reporting"
          }
        }
      ],
      "metadata": {
        "source_type": "finance_plan",
        "business_area": "infrastructure"
      }
    },
    {

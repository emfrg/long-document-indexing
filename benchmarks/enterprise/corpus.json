        {
          "id": "northwind_escalation_s3",
          "document_id": "doc_northwind_escalation",
          "order": 3,
          "text": "Engineering traced the failure to a timezone conversion bug in the nightly billing job.",
          "metadata": {
            "section": "root_cause"
          }
        }
      ],
      "metadata": {
        "source_type": "support_log",

# Optional real model settings. Values ending in DEPLOYMENT or MODEL are Azure
# deployment names, not model-family names; each named deployment must already exist.
# The default smoke config uses the fake local generator.
FOUNDRY_GENERATOR_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
FOUNDRY_GENERATOR_DEPLOYMENT=
FOUNDRY_ROUTER_MODEL=
FOUNDRY_ANSWER_MODEL=
FOUNDRY_GENERATOR_API=responses
FOUNDRY_GENERATOR_MAX_OUTPUT_TOKENS=2000
FOUNDRY_GENERATOR_RESPONSE_FORMAT=structured
AZURE_INFERENCE_CREDENTIAL=
FOUNDRY_EVALUATION_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_JUDGE_MODEL=
FOUNDRY_EMBEDDING_MODEL=
